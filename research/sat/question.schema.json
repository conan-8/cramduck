{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cramduck/research/sat/question.schema.json",
  "title": "Normalized SAT Question",
  "description": "Normalized contract for one harvested Digital SAT question (internal_eval only).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "origin",
    "section",
    "domain",
    "skill",
    "difficultyOfficial",
    "difficultyInternal",
    "questionType",
    "stimulus",
    "stem",
    "choices",
    "correctAnswer",
    "rationale",
    "sourceUrl",
    "harvestedAt",
    "allowedUses"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^ssqb-.+",
      "description": "ssqb-<original College Board id>"
    },
    "origin": {
      "type": "string",
      "enum": ["bluebook", "question_bank"],
      "description": "bluebook = the question appears in a Bluebook practice exam; question_bank = general online question-bank item"
    },
    "section": {
      "type": "string",
      "enum": ["reading-writing", "math"]
    },
    "domain": {
      "type": "string",
      "enum": [
        "Information and Ideas",
        "Craft and Structure",
        "Standard English Conventions",
        "Expression of Ideas",
        "Algebra",
        "Advanced Math",
        "Problem-Solving and Data Analysis",
        "Geometry and Trigonometry"
      ],
      "description": "Exact domain display name from the canonical taxonomy"
    },
    "skill": {
      "type": "string",
      "enum": [
        "central-ideas-details",
        "command-evidence-textual",
        "command-evidence-quantitative",
        "inferences",
        "words-in-context",
        "text-structure-purpose",
        "cross-text-connections",
        "boundaries",
        "form-structure-sense",
        "transitions",
        "rhetorical-synthesis",
        "linear-equations-one-var",
        "linear-functions",
        "linear-equations-two-vars",
        "systems-linear-equations",
        "linear-inequalities",
        "equivalent-expressions",
        "nonlinear-functions",
        "nonlinear-equations-systems",
        "ratios-rates-proportions",
        "percentages",
        "one-variable-data",
        "two-variable-data",
        "probability-conditional",
        "sample-statistics-margin-error",
        "evaluating-claims",
        "area-volume",
        "lines-angles-triangles",
        "right-triangles-trig",
        "circles"
      ],
      "description": "Exact skill slug from the canonical taxonomy"
    },
    "difficultyOfficial": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "difficultyInternal": {
      "type": "integer",
      "enum": [2, 3, 4],
      "description": "easy->2, medium->3, hard->4"
    },
    "questionType": {
      "type": "string",
      "enum": ["mcq", "grid_in"]
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "tableJson", "figureAsset"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["passage", "table", "figure", "notes", "none"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "tableJson": {
          "type": ["object", "null"]
        },
        "figureAsset": {
          "type": ["string", "null"],
          "pattern": "^assets\\/.+\\.(svg|png)$",
          "description": "assets/<sourceId>.svg|.png, or null"
        }
      }
    },
    "needsTranscription": {
      "type": "boolean",
      "description": "true when the hollow math text layer left stem/choices unrecoverable at harvest time; a vision pass must fill them"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "at"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^(pdf-text|ssqb-api|vision(:.+)?)$",
          "description": "where the current content came from; vision entries carry the model as vision:<model>"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "verified": {
          "type": "boolean",
          "description": "an independent-solver pass confirmed the transcription"
        }
      }
    },
    "stem": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["A", "B", "C", "D"]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "correctAnswer": {
      "type": "string",
      "minLength": 1,
      "description": "A-D for mcq; numeric string for grid_in (e.g. '12', '3.5', '3/4')"
    },
    "rationale": {
      "type": ["string", "null"]
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "harvestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "allowedUses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["internal_eval"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "questionType": { "const": "grid_in" } },
        "required": ["questionType"]
      },
      "then": {
        "properties": {
          "choices": {
            "type": "array",
            "minItems": 0,
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "questionType": { "const": "mcq" } }, "required": ["questionType"] },
          {
            "not": {
              "properties": { "needsTranscription": { "const": true } },
              "required": ["needsTranscription"]
            }
          }
        ]
      },
      "then": {
        "properties": {
          "choices": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4
          },
          "correctAnswer": {
            "type": "string",
            "enum": ["A", "B", "C", "D"]
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": { "needsTranscription": { "const": true } },
          "required": ["needsTranscription"]
        }
      },
      "then": {
        "properties": { "stem": { "minLength": 1 } }
      }
    },
    {
      "if": {
        "properties": { "difficultyOfficial": { "const": "easy" } },
        "required": ["difficultyOfficial"]
      },
      "then": {
        "properties": { "difficultyInternal": { "const": 2 } }
      }
    },
    {
      "if": {
        "properties": { "difficultyOfficial": { "const": "medium" } },
        "required": ["difficultyOfficial"]
      },
      "then": {
        "properties": { "difficultyInternal": { "const": 3 } }
      }
    },
    {
      "if": {
        "properties": { "difficultyOfficial": { "const": "hard" } },
        "required": ["difficultyOfficial"]
      },
      "then": {
        "properties": { "difficultyInternal": { "const": 4 } }
      }
    }
  ]
}
