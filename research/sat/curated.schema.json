{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cramduck/research/sat/curated.schema.json",
  "title": "Curated SAT Question (display-ready)",
  "description": "Human-curated, display-ready record for one Digital SAT question. Fields map 1:1 to simulator regions: info = left pane, prompt = text above the answer options, options/gridAnswer = answer area, diagram = standalone figure PNG. Metadata (origin/domain/skill/difficulty) is joined from the harvested bank by sourceId at import time. Internal_eval only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "origin",
    "section",
    "domain",
    "skill",
    "difficultyOfficial",
    "difficultyInternal",
    "questionType",
    "info",
    "prompt",
    "options",
    "correctAnswer",
    "rationale",
    "diagram",
    "sourceUrl",
    "harvestedAt",
    "curatedAt",
    "allowedUses"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^ssqb-[0-9a-f]+$",
      "description": "ssqb-<original College Board id>"
    },
    "origin": {
      "type": "string",
      "enum": ["bluebook", "question_bank"]
    },
    "section": {
      "type": "string",
      "enum": ["reading-writing", "math"]
    },
    "domain": {
      "type": "string",
      "enum": [
        "Information and Ideas",
        "Craft and Structure",
        "Standard English Conventions",
        "Expression of Ideas",
        "Algebra",
        "Advanced Math",
        "Problem-Solving and Data Analysis",
        "Geometry and Trigonometry"
      ]
    },
    "skill": {
      "type": "string",
      "description": "Exact skill slug from the canonical taxonomy (see question.schema.json)"
    },
    "difficultyOfficial": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "difficultyInternal": {
      "type": "integer",
      "enum": [2, 3, 4]
    },
    "questionType": {
      "type": "string",
      "enum": ["mcq", "grid_in"]
    },
    "info": {
      "type": ["string", "null"],
      "description": "Left-pane stimulus text exactly as displayed. null when the question has none. Author markup: \\( \\) LaTeX, [[ ]] underline, **bold**, *italic*, blank line = paragraph."
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Question text rendered above the answer options."
    },
    "options": {
      "type": "array",
      "description": "Exactly 4 choices for mcq; empty array for grid_in.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gridAnswer": {
      "type": ["string", "null"],
      "description": "Student-produced-response answer (e.g. '13/2', '403'); null for mcq."
    },
    "correctAnswer": {
      "type": "string",
      "minLength": 1,
      "description": "A-D for mcq; equals gridAnswer for grid_in."
    },
    "rationale": {
      "type": ["string", "null"],
      "description": "Curated explanation text (authoritative over the harvested rationale)."
    },
    "diagram": {
      "type": ["string", "null"],
      "pattern": "^assets/figures/.+\\.(png|jpe?g|svg)$",
      "description": "Standalone figure image (user-supplied site export overrides the PDF crop), or null."
    },
    "tableJson": {
      "type": ["object", "null"],
      "description": "Structured table figure from the API (rendered natively instead of an image).",
      "properties": {
        "caption": { "type": ["string", "null"] },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array" } }
      }
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "harvestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Inherited from the harvested record."
    },
    "curatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was imported from the curation workbook."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "at"],
      "description": "Manual approval state from the /review tool. Absent = pending.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["approved", "returned"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["info-prompt-split", "options", "figure", "other"]
          }
        },
        "note": {
          "type": ["string", "null"]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "allowedUses": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["internal_eval"] }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "questionType": { "const": "mcq" } },
        "required": ["questionType"]
      },
      "then": {
        "properties": {
          "options": { "minItems": 4, "maxItems": 4 },
          "gridAnswer": { "const": null },
          "correctAnswer": { "enum": ["A", "B", "C", "D"] }
        }
      }
    },
    {
      "if": {
        "properties": { "questionType": { "const": "grid_in" } },
        "required": ["questionType"]
      },
      "then": {
        "properties": {
          "options": { "maxItems": 0 },
          "gridAnswer": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "difficultyOfficial": { "const": "easy" } },
        "required": ["difficultyOfficial"]
      },
      "then": { "properties": { "difficultyInternal": { "const": 2 } } }
    },
    {
      "if": {
        "properties": { "difficultyOfficial": { "const": "medium" } },
        "required": ["difficultyOfficial"]
      },
      "then": { "properties": { "difficultyInternal": { "const": 3 } } }
    },
    {
      "if": {
        "properties": { "difficultyOfficial": { "const": "hard" } },
        "required": ["difficultyOfficial"]
      },
      "then": { "properties": { "difficultyInternal": { "const": 4 } } }
    }
  ]
}
